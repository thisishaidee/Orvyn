# Orvynn contract deployment template for Arc mainnet.
#
# Copy this file to `.env` on YOUR OWN machine and fill it in:
#   cp .env.example .env
#
# WARNING: `.env` holds a private key. NEVER commit it to git, paste it into a chat,
# or upload it to a shared sandbox. `.env` is listed in `.gitignore`; keep it that way.
# This `.env.example` is committed to version control, so it must contain NO secrets
# and no real wallet addresses. Leave the values below empty here and fill them in `.env`.

# Private key of the wallet that deploys the Orvynn contract (0x + 64 hex characters, 66 total).
# It is the ONLY variable that takes the private key. This wallet pays gas in USDC.
DEPLOYER_PRIVATE_KEY=

# Public address (0x + 40 hex characters) of the wallet above. The deploy script aborts
# if the key does not derive this address, which catches a wrong-key mistake.
DEPLOYER_ADDRESS=

# Arc RPC endpoints. Testnet first; do not broadcast until preflight review.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Max fee per gas in wei (plain integer). Arc enforces a 20 gwei minimum (20000000000).
# This default is 30 gwei. It is a cap, not what you pay; you pay the actual base fee.
ARC_MAX_FEE_WEI=30000000000

# Priority fee (tip) in wei. 1 gwei = 1000000000. 0 is also accepted.
ARC_PRIORITY_FEE_WEI=1000000000


# Optional frontend contract addresses. Leave empty until the Orvynn contract is deployed.
# Do not invent an address. The app reports a missing address honestly when these are blank.
# Arc Mainnet is chain ID 5042. Arc Testnet is chain ID 5042002.
VITE_AGENTPAY_ADDRESS_MAINNET=
VITE_AGENTPAY_ADDRESS_TESTNET=
